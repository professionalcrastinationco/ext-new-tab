{
  "manifest_version": 3,
  "name": "Dockside: New Tab Page & Bookmarks",
  "version": "2026.11.13",
  "description": "A calm new tab page: your bookmarks in tidy categories, a quick links dock and your choice of search engine.",
  "permissions": ["storage", "tabs"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Save to Dockside"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
